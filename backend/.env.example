# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Firebase / Firestore
# When running on Cloud Run with a service account, these aren't needed.
# For local dev, point to your Firebase project.
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
FIRESTORE_PROJECT_ID=your-firebase-project-id

# Auto-sync: how often to check your calendars for new or edited events,
# in seconds (minimum 30). Optional; defaults to 120.
SYNC_POLL_SECONDS=120

# Server
PORT=3000
BACKEND_URL=http://localhost:3000

# Extension: the ID on chrome://extensions. To let several people's copies
# use this backend, list them separated by spaces.
EXTENSION_ID=your-chrome-extension-id

# ---------------------------------------------------------------------------
# Cloud deployment only (leave unset locally)
# ---------------------------------------------------------------------------
# "cloud" on Cloud Run: no internal timers, Cloud Scheduler calls /internal/tick.
# RUN_MODE=cloud
# Shared secret the extension sends as x-api-key. Generate: openssl rand -hex 32
# API_KEY=
# Shared secret Cloud Scheduler sends as x-tick-secret. Generate the same way.
# TICK_SECRET=
# Only these Google accounts may sign in (separate with spaces or commas).
# Optional locally, required in cloud mode.
# ALLOWED_EMAILS=you@gmail.com partner@gmail.com

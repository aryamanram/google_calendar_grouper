# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Firebase / Firestore
# When running on Cloud Run with a service account, these aren't needed.
# For local dev, point to your Firebase project.
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
FIRESTORE_PROJECT_ID=your-firebase-project-id

# Auto-sync: how often to check your calendars for new or edited events,
# in seconds (minimum 30). Optional; defaults to 120.
SYNC_POLL_SECONDS=120

# Server
PORT=3000
BACKEND_URL=http://localhost:3000

# Optional: only let these copies of the extension (IDs from
# chrome://extensions, separated by spaces) sign in. Leave unset to allow any
# copy; who may sign in is decided by Google account (see ALLOWED_EMAILS).
# EXTENSION_ID=

# ---------------------------------------------------------------------------
# Cloud deployment only (leave unset locally)
# ---------------------------------------------------------------------------
# "cloud" on Cloud Run: no internal timers, Cloud Scheduler calls /internal/tick.
# RUN_MODE=cloud
# Shared secret Cloud Scheduler sends as x-tick-secret. Generate: openssl rand -hex 32
# TICK_SECRET=
# The backend's owners: they can sign in and invite or remove people from the
# extension (separate with spaces or commas). Optional locally, where anyone
# may sign in; required in cloud mode.
# ALLOWED_EMAILS=you@gmail.com partner@gmail.com

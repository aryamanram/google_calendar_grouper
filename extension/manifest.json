{
  "manifest_version": 3,
  "name": "Calendar Grouper",
  "version": "1.0.0",
  "description": "Share your Google Calendars as one calendar someone can toggle on and off, without merging them.",
  "homepage_url": "https://calendargrouper.com",
  "permissions": ["identity", "storage"],
  "action": {
    "default_popup": "popup/dist/index.html",
    "default_title": "Calendar Grouper",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://calendargrouper.com/join*"],
      "js": ["join.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
